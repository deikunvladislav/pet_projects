<Window x:Class="WarehouseApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WarehouseApp.ViewModels"
        Title="WarehouseApp" Height="450" Width="1050">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель добавления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Название:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Width="150" Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,10,0"/>

            <TextBlock Text="Цена:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Width="100" Text="{Binding NewProductPrice, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,10,0"
                     ToolTip="Цена от 0 до 1 000 000 руб."/>

            <TextBlock Text="Кол-во:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Width="50" Text="{Binding NewProductQuantity, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,10,0"
                     ToolTip="Количество от 0 до 1 000 000 шт."/>

            <Button Content="Добавить" Command="{Binding AddCommand}" Width="80" Margin="0,0,10,0"/>
            <Button Content="Обновить" Command="{Binding UpdateCommand}" Width="80" Margin="0,0,5,0"
                    ToolTip="Сначала выберите товар в таблице"
                    ToolTipService.ShowOnDisabled="True"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Width="80" Margin="0,0,5,0"
                    ToolTip="Сначала выберите товар в таблице"
                    ToolTipService.ShowOnDisabled="True"/>
            <Button Content="Очистить" Command="{Binding ClearCommand}" Width="80" Margin="0,0,5,0"/>
            <Button Content="Справка" Command="{Binding HelpCommand}" Width="80"/>
        </StackPanel>

        <!-- Таблица товаров -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Products}" 
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>